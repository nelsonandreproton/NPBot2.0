# ======================
# Azure Bot Configuration
# ======================
# Get these from Azure Portal > Bot Services > your bot > Configuration
MICROSOFT_APP_ID=your-bot-app-id
MICROSOFT_APP_PASSWORD=your-bot-app-secret
MICROSOFT_APP_TENANT_ID=your-tenant-id

# ======================
# Azure AD / Entra ID (for Graph API access via OBO)
# ======================
# Same app registration, but with Graph API delegated permissions configured
# Required scopes: Mail.Read, Mail.Send, Files.Read.All, Calendars.Read,
#                  Chat.Read, ChannelMessage.Read.All, User.Read
OAUTH_CONNECTION_NAME=GraphConnection

# ======================
# Ollama Configuration
# ======================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ======================
# Server Configuration
# ======================
PORT=3978

# ======================
# Web Search (optional — DuckDuckGo by default, no key needed)
# ======================
# SEARXNG_URL=http://localhost:8080

# ======================
# Logging
# ======================
LOG_LEVEL=info
